modules = ["nodejs-22"]
run = "bash scripts/replit-web.sh"
hidden = ["ios", "android", ".expo", "dist", "node_modules"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/replit-web.sh", "build"]
run = ["bash", "scripts/replit-web.sh", "serve"]
