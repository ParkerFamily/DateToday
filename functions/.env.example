# Loaded by Firebase Functions (never commit real keys)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=DateToday <onboarding@resend.dev>
PERSONA_API_KEY=
# Optional: only if "Enhanced security for push notifications" is on in expo.dev → Account → Access tokens
EXPO_ACCESS_TOKEN=
# Owner-only key for marketing broadcasts (scripts/broadcast.mjs). Generate: openssl rand -hex 32
BROADCAST_SECRET=
