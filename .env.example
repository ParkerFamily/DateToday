# Firebase (primary backend) — values also baked from GoogleService-Info.plist
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=datetoday-e1331.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=datetoday-e1331
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=datetoday-e1331.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=626033907762
EXPO_PUBLIC_FIREBASE_APP_ID=

# Android Firebase app id from google-services.json (mobilesdk_app_id)
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=

EXPO_PUBLIC_APP_ENV=development
# Fake Ping people — ONLY set true when you intentionally want demo cards. Never for store builds.
EXPO_PUBLIC_USE_MOCK_DATA=false
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Persona — public template + environment IDs
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=itmpl_YOUR_TEMPLATE_ID
EXPO_PUBLIC_PERSONA_ENVIRONMENT_ID=env_YOUR_ENVIRONMENT_ID

# RevenueCat (App Store / Play IAP)
# RevenueCat — store SDK keys (never commit real secrets to git if private)
# iOS: Project settings → Apple App → Public API key (starts with appl_)
# Android: Project settings → Google Play App → Public API key (starts with goog_)
# Test Store (test_) only works in Metro __DEV__ — release builds will skip/crash if forced.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_YOUR_ANDROID_KEY

# Optional Android Google OAuth client (native Sign-In mainly needs WEB client ID)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Server-only (Firebase Cloud Functions / local — NEVER EXPO_PUBLIC_)
PERSONA_API_KEY=persona_sandbox_YOUR_API_KEY
PERSONA_TEMPLATE_ID=itmpl_YOUR_TEMPLATE_ID
PERSONA_WEBHOOK_SECRET=
