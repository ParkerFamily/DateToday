rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only confirmPersonaVerification (Admin SDK) can set 'verified'. Clients may record
    // in-progress states, or leave an existing server-set 'verified' untouched.
    function verificationNotForged() {
      return !('verificationStatus' in request.resource.data)
        || request.resource.data.verificationStatus in [
          'unverified',
          'pending',
          'failed',
          'manual_review',
        ]
        || (
          resource != null
          && resource.data.get('verificationStatus', '') == 'verified'
          && request.resource.data.verificationStatus == 'verified'
        );
    }

    // Denormalized cards (live / nearby) may only claim 'verified' if the account is.
    function verifiedMatchesAccount(userId) {
      return request.resource.data.get('verificationStatus', '') != 'verified'
        || get(/databases/$(database)/documents/users/$(userId)).data.get('verificationStatus', '') == 'verified';
    }

    // Prevent self-granting paid plan / role fields if present on the doc.
    function entitlementsNotForged() {
      return !('plan' in request.resource.data)
        || request.resource.data.plan == 'free'
        || (
          resource != null
          && request.resource.data.plan == resource.data.plan
        );
    }

    // Only block *new* private fields on write — existing keys on merge must not
    // poison every later update (verificationStatus, photo, etc.).
    function privateProfileKeys() {
      return [
        'dateOfBirth',
        'email',
        'phone',
        'phoneNumber',
        'latitude',
        'longitude',
        'exactLocation',
        'personaRaw',
        'governmentId',
        'password',
        'personaInquiryId',
        'verifiedAt',
        'verificationCheckedAt',
      ];
    }

    function noPrivateLeakOnProfile() {
      return resource == null
        ? !request.resource.data.keys().hasAny(privateProfileKeys())
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(privateProfileKeys());
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && verificationNotForged() && entitlementsNotForged()
        && legalNameValid();
      allow update: if isOwner(userId) && verificationNotForged() && entitlementsNotForged()
        && legalNameValid() && legalNameLocked()
        && (resource.data.get('phoneVerificationRequired', false) != true
          || request.resource.data.get('phoneVerificationRequired', false) == true);
      allow delete: if isOwner(userId) && resource.data.get('phoneVerificationRequired', false) != true;

      function legalNameValid() {
        return !('legalName' in request.resource.data)
          || (request.resource.data.legalName is string
            && request.resource.data.legalName.size() <= 80);
      }

      // Set once during onboarding; the name on your ID can't be edited afterwards.
      function legalNameLocked() {
        return !('legalName' in resource.data)
          || request.resource.data.get('legalName', null) == resource.data.legalName;
      }
    }

    // One doc per device (id derived from the Expo token), so a phone only ever
    // notifies the account currently signed in on it. Read by Cloud Functions.
    match /pushTokens/{tokenId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() < 300
        && request.resource.data.get('enabled', true) is bool
        && request.resource.data.keys().hasOnly([
          'uid', 'token', 'platform', 'enabled', 'appVersion', 'deviceName', 'deviceModel',
          'manufacturer', 'osName', 'osVersion', 'isPhysicalDevice', 'createdAt', 'updatedAt',
          'lastError', 'invalidatedAt'
        ]);
    }

    // Per-user notification choices; read by Cloud Functions before every push.
    match /notificationPrefs/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'matches', 'messages', 'likes', 'dateRequests', 'dateUpdates', 'reminders',
          'liveUpdates', 'promotions', 'system', 'emailActivity', 'emailNews', 'updatedAt'
        ]);
      allow delete: if isOwner(userId);
    }

    // Expo push tickets awaiting receipt checks — Cloud Functions only.
    match /pushTickets/{ticketId} {
      allow read, write: if false;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && noPrivateLeakOnProfile()
        && verificationNotForged();
      allow delete: if isOwner(userId);
    }

    match /deleted_users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if false;
    }

    // Written only by the blockUser / unblockUser functions so the mutual hide stays consistent.
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow write: if false;
    }

    // Everyone this user must never see: people they blocked + people who blocked them.
    match /hiddenUsers/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string
        && request.resource.data.reporterId != request.resource.data.reportedId
        && request.resource.data.status == 'open';
      allow read, update, delete: if false;
    }

    // Approximate live beacons for Ping discovery (rounded lat/lng only).
    match /liveSessions/{userId} {
      // Travel Mode: a labelled city + dates, never presented as physically nearby.
      function validTrip(d) {
        return !('trip' in d) || d.trip == null || (
          d.trip is map
          && d.trip.city is string && d.trip.city.size() > 0 && d.trip.city.size() <= 60
          && d.trip.startsOn is string && d.trip.startsOn.size() == 10
          && d.trip.endsOn is string && d.trip.endsOn.size() == 10
          && d.trip.startsOn <= d.trip.endsOn
        );
      }
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && verifiedMatchesAccount(userId)
        && validTrip(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Non-live "nearby" presence (rounded lat/lng + public card fields) so the feed isn't empty.
    match /nearbyProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId
        && verifiedMatchesAccount(userId);
      allow delete: if isOwner(userId);
    }

    // Activation coordinates and cooldown timestamps are only readable/writable
    // by the Admin SDK. Clients cannot forge or sweep these records.
    match /liveActivations/{userId} {
      allow read, write: if false;
    }

    // Reply speed / recent plans / join date behind Discover status tags. Cloud Functions only.
    match /userStats/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Hearts. Written only by the sendInterest Cloud Function (mutual check + push).
    // Only the sender reads a heart. Who liked you is served by getLikes, which hides likers'
    // identities from free members.
    match /interests/{interestId} {
      allow read: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow write: if false;
    }

    // Bumped by sendInterest so the app knows to refetch getLikes. No identities inside.
    match /likeInbox/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Server-verified DateToday+ (RevenueCat) cache; blurred like thumbnails. Functions only.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /likeBlurs/{userId} {
      allow read, write: if false;
    }

    // DateToday+ bought through the web checkout, written only by the Stripe webhook.
    match /webSubscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    // Stripe customer ids, one-account checkout tickets and the checkout feature flag. Functions only.
    match /stripeCustomers/{userId} {
      allow read, write: if false;
    }
    match /webCheckoutTickets/{ticketId} {
      allow read, write: if false;
    }
    match /appConfig/{docId} {
      allow read, write: if false;
    }

    // Unmatched pairs (unmatchUser) and trigger dedupe markers; Cloud Functions only.
    match /unmatches/{pairId} {
      allow read, write: if false;
    }
    match /processedEvents/{eventId} {
      allow read, write: if false;
    }

    // Cached quiz match % per pair; read and written only by getCompatibility.
    match /compatibility/{pairId} {
      allow read, write: if false;
    }

    // Place search results cache; searchPlaces only.
    match /placeCache/{key} {
      allow read, write: if false;
    }

    // Mutual matches; created only by Cloud Functions. Members may reset their own unread count.
    match /matches/{matchId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.userIds;
      }

      function isMatchMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
      }

      allow read: if isMember();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
        && request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.unread[request.auth.uid] == 0;
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchMember();

        allow create: if isMatchMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'createdAt'])
              && request.resource.data.text is string
              && request.resource.data.text.trim().size() > 0
              && request.resource.data.text.size() <= 2000
            )
            || (
              request.resource.data.type == 'date_proposal'
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'proposal', 'status', 'createdAt'])
              && request.resource.data.status == 'proposed'
              && request.resource.data.proposal is map
              && request.resource.data.proposal.keys().hasOnly([
                'activity', 'activityLabel', 'whenLabel', 'venueName', 'venueAddress',
                'neighborhood', 'venueLat', 'venueLng', 'startsAt', 'note'
              ])
            )
          );

        // Only the recipient answers a date proposal, once.
        allow update: if isMatchMember()
          && resource.data.type == 'date_proposal'
          && resource.data.senderId != request.auth.uid
          && resource.data.status == 'proposed'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.respondedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'respondedBy'])
          && request.resource.data.respondedBy == request.auth.uid;

        allow delete: if false;
      }

      // Read receipts + typing. Each member writes only their own doc.
      // Reciprocal: you can read someone else's only while you both have receipts on.
      match /members/{memberId} {
        function receiptsOn(uid) {
          let path = /databases/$(database)/documents/users/$(uid);
          return !exists(path)
            || get(path).data.get('privacyControls', {}).get('readReceipts', true) != false;
        }

        allow read: if isMatchMember()
          && (memberId == request.auth.uid
            || (receiptsOn(request.auth.uid) && receiptsOn(memberId)));
        allow create, update: if isMatchMember()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastReadAt', 'typingAt'])
          && (request.resource.data.get('lastReadAt', null) == null
            || (request.resource.data.lastReadAt is timestamp && request.resource.data.lastReadAt <= request.time))
          && (request.resource.data.get('typingAt', null) == null
            || (request.resource.data.typingAt is timestamp && request.resource.data.typingAt <= request.time));
        allow delete: if false;
      }
    }
  }
}
