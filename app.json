{
  "expo": {
    "name": "DateToday",
    "slug": "date-today",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datetoday",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkerfamily.datetoday",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "DateToday",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "DateToday uses your location to show people who are actually available near you. Exact coordinates are never shared with other users.",
        "NSCameraUsageDescription": "DateToday needs camera access for profile and tonight videos.",
        "NSMicrophoneUsageDescription": "DateToday needs microphone access to record video prompts.",
        "NSPhotoLibraryUsageDescription": "DateToday needs photo library access to upload profile media.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "datetoday"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.626033907762-l00sub102ttvc96t1hkqsbij6rdq0a7r"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "datetoday"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.626033907762-l00sub102ttvc96t1hkqsbij6rdq0a7r"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.parkerfamily.datetoday",
      "label": "DateToday",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "datetoday"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#09090B",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#09090B",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.626033907762-l00sub102ttvc96t1hkqsbij6rdq0a7r"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DateToday uses your location to show people who are actually available near you."
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "DateToday needs camera access to record video prompts live.",
          "microphonePermission": "DateToday needs microphone access to record video prompts.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DateToday needs photo library access so you can choose a profile photo.",
          "cameraPermission": "DateToday needs camera access for profile and tonight videos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appEnv": "production",
      "eas": {
        "projectId": "f884fefe-8fba-40f2-954a-aec0bcb30174"
      },
